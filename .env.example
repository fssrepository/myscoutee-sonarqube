# run.sh SOURCE_REPOSITORY init creates .state/<id>/.env with a random password.
SONAR_DB_PASSWORD=replace-with-a-local-password
# Configure the loopback port in the source repository's sonarqube/project.json.
# Generate a Global Analysis Token in the local SonarQube UI for scan all.
# An individual scan can also use a token scoped to that project.
SONAR_TOKEN=
# Optional private record of the admin password set through the UI/API.
# This value is not applied to the server by Compose.
SONAR_ADMIN_PASSWORD=
